[Unit]
Description=llama.cpp Vulkan LLM API - primary dialogue (Qwen2.5-3B)
After=gpu-powercap.service network-online.target
Wants=gpu-powercap.service network-online.target

[Service]
User=pi
Environment=GGML_VK_VISIBLE_DEVICES=0
ExecStart=/home/pi/llama.cpp/build/bin/llama-server -m /home/pi/comfy/models/llm/Qwen2.5-3B-Instruct-Q4_K_M.gguf --host 0.0.0.0 --port 8080 -ngl 99 -c 4096 -np 2 -fa on -t 4 --alias qwen2.5-3b
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
