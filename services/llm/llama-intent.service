[Unit]
Description=llama.cpp Vulkan LLM API - fast secondary (Qwen2.5-1.5B)
After=gpu-powercap.service network-online.target llama-primary.service
Wants=gpu-powercap.service network-online.target

[Service]
User=pi
ExecStart=/home/pi/llama.cpp/build/bin/llama-server -m /home/pi/comfy/models/llm/Qwen2.5-1.5B-Instruct-Q4_K_M.gguf --host 0.0.0.0 --port 8081 -ngl 99 -c 4096 -np 2 -fa on -t 4 --alias qwen2.5-1.5b
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
