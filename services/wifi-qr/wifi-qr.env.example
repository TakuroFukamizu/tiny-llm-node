# /etc/default/wifi-qr
#
# Configuration for the wifi-qr daemon (systemd: wifi-qr.service).
# Loaded via EnvironmentFile=; every setting is optional and the values shown
# are the built-in defaults. Edit, then: sudo systemctl restart wifi-qr
#
# NOTE: this file is read by systemd, not by a shell: no "export", and no
# $VAR expansion.

# I2C bus number. Raspberry Pi GPIO header (SDA=GPIO2, SCL=GPIO3) is bus 1,
# i.e. /dev/i2c-1. Must match DeviceAllow= in wifi-qr.service if changed.
WIFI_QR_I2C_BUS=1

# I2C address of the M5Stack Unit QRCode (fixed at 0x21 by the firmware).
WIFI_QR_I2C_ADDR=0x21

# WiFi interface that NetworkManager profiles are bound to.
WIFI_QR_IFACE=wlan0

# Seconds between READY register polls. Lower values react faster at the cost
# of more I2C traffic; 0.2 is plenty for a hand-held QR code.
WIFI_QR_POLL_INTERVAL=0.2

# Bytes per I2C read transaction when fetching the decoded payload
# (0x1000..0x11FF, up to 512 bytes). 32 is a conservative default; raise it
# after verifying on real hardware that larger reads work.
WIFI_QR_READ_CHUNK=32

# Testing without hardware: when set, the daemon uses a fake scanner that
# "scans" this payload instead of talking to I2C. Combine with --dry-run so
# that nmcli is not invoked. Never leave this set in production.
#WIFI_QR_FAKE_SCANNER=WIFI:T:nopass;S:wifi-qr-test;;
